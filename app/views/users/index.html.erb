<h3 style="color:MediumSeaGreen;"><%= notice %></h3>

<h1> USER LIST</h1>
<table>
  <thead>
  	<style>
      table {border-collapse: separate;border-spacing: 0 15px;}
      th {background-color: #4287f5;color: white;}
      th,
      td{width: 150px;text-align: center;border: 1px solid black;padding:5px;}
      </style>
    <tr>
      <th>USERNAME</th>
      <th>EMAIL</th>
      
      <th>DESTROY</th>
      <th>UPDATE</th>

      <!-- <th colspan="20"></th> -->
    </tr>
  </thead>

  <tbody>
    <% @user.each do |user| %>
      <tr>
        <td><%=  user.username %></td>
        <td><%=  user.email %></td>
        
        
        <td><%=button_to "Update", edit_user_path(user.id), method: :get %></td>
        <td><%= link_to "Destroy", user_path(user.id), data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure?"
                  } %></td>
       </tr>
    <% end %>
  </tbody>
</table><br>
<%= button_to "BACK", root_path , method: :get %>
