<h3 style="color:MediumSeaGreen;"><%= notice %></h3>
<h1>All Teachers in  school</h1>
<table>
  <thead>
  	<style>
      table {border-collapse: separate;border-spacing: 0 15px;}
      th {background-color: #4287f5;color: white;}
      th,
      td{width: 150px;text-align: center;border: 1px solid black;padding:5px;}
      </style>
    <tr>
      <th>NAME</th>
      <th>VIEW</th>
      <th>EDIT</th>
      <th>DELETE</th>
      <!-- <th colspan="20"></th> -->
    </tr>
  </thead>
 
  <tbody>
    
    <% @teachers.each do |teacher| %>
    
      <tr>
        <td><%= teacher.name %></td>
       
        <td><%= link_to "Show", teacher_path(teacher.id), method: :get %></td>
        <td><%= button_to "Update", edit_teacher_path(teacher.id) ,method: :get%></td>
        <td>
                  <%= link_to "delete",teacher_path(teacher.id), data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure?"
                } %></td>
       </tr>
    <% end %>
  </tbody>
</table><br>
<%= button_to "New Teacher", new_teacher_path,method: :get %><br>
<%= button_to "Back", root_path, class: "btn btn-default",method: :get %>